DATABASE_URL=mysql://root@localhost:3306/rust_web_app
RUST_LOG=style_engine=debug,tower_http=debug

# ─── LLM provider ───
OPENAI_API_KEY=sk-your-key-here
# Anthropic은 선택. 미설정 시 anthropic으로 라우팅된 task만 실패하고 나머지는 정상 동작.
ANTHROPIC_API_KEY=

# task별 라우팅이 명시되지 않았을 때 쓰는 provider (openai | anthropic)
LLM_DEFAULT_PROVIDER=openai

# task 단위 모델 교체. "provider:model" 또는 "model"(provider는 기본값 유지).
# 지정하지 않으면 코드의 기본값(gpt-4o-mini 등)을 쓴다.
# LLM_TASK_VISION_PASS1=anthropic:claude-opus-5
# LLM_TASK_VISION_PASS2=anthropic:claude-opus-5
# LLM_TASK_CHAT_AGENT=anthropic:claude-sonnet-5
# LLM_TASK_STYLE_NOTE=gpt-4o
# LLM_TASK_OUTFIT_CANDIDATES=gpt-4o-mini
# LLM_TASK_OUTFIT_EXPLANATION=gpt-4o-mini
# LLM_TASK_OUTFIT_RECOMMENDATION=gpt-4o-mini
# LLM_TASK_VISION_ANALYZE=gpt-4o-mini
# LLM_TASK_GENDER_VERIFY=gpt-4o-mini
# LLM_TASK_IMAGE_GENERATION=gpt-image-2
# LLM_TASK_EMBEDDING=text-embedding-3-small

# 호출 정책
LLM_TIMEOUT_SECS=60
LLM_MAX_RETRIES=2
# Anthropic output_config.effort (low | medium | high | xhigh | max)
LLM_ANTHROPIC_EFFORT=low

# 임베딩 모델의 출력 차원. LLM_TASK_EMBEDDING을 다른 차원의 모델로 바꾸면 여기도 바꿔야
# 기존 벡터가 폐기되고 재생성된다 (예: text-embedding-3-large → 3072).
LLM_EMBEDDING_DIM=1536

# 기상청 API 키 (공공데이터포털 발급, Encoding 버전 사용)
# 미설정 시 Open-Meteo 폴백
KMA_API_KEY=
